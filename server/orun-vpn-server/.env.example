# IP público ou hostname (DDNS) do servidor
WG_HOST=vpn.orun.dev

# Gerar com: docker run ghcr.io/wg-easy/wg-easy wgpw 'SUA_SENHA_FORTE'
#
# ATENÇÃO (crítico): o hash bcrypt contém '$'. No `.env`, cada '$' precisa
# ser duplicado como '$$' — o Docker Compose converte '$$' de volta para '$'
# ao passar a variável pro container. Sem isso o compose interpreta '$ED...'
# como uma variável e TRUNCA o hash (wg-easy recusa senha inválida).
# Ex.: se o `wgpw` retorna `$2a$12$ED4...`, copie como `$$2a$$12$$ED4...`
WG_EASY_PASSWORD_HASH=
